{
  "name": "spec-compiler-mvp",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "mcp": "tsx mcp/server.ts",
    "mcp:build": "esbuild mcp/server.ts --bundle --platform=node --target=node18 --format=esm --outfile=mcp/dist/server.mjs --banner:js=\"#!/usr/bin/env node\nimport{createRequire}from'module';const require=createRequire(import.meta.url);\"",
    "mcp:pack": "esbuild mcp/server.ts --bundle --platform=node --target=node18 --format=esm --outfile=../mcp-server/dist/server.mjs --banner:js=\"#!/usr/bin/env node\nimport{createRequire}from'module';const require=createRequire(import.meta.url);\""
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.113.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "lucide-react": "0.400.0",
    "next": "14.2.35",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "20.12.12",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "autoprefixer": "10.4.19",
    "esbuild": "^0.28.1",
    "eslint": "^8.57.0",
    "eslint-config-next": "^14.2.35",
    "postcss": "8.4.38",
    "tailwindcss": "3.4.3",
    "tsx": "^4.23.1",
    "typescript": "5.4.5",
    "vitest": "^2.1.9"
  }
}
